--- a/smali_classes2/com/android/systemui/power/feature/aod/AodTriggerController.smali
+++ b/smali_classes2/com/android/systemui/power/feature/aod/AodTriggerController.smali
@@ -286,7 +286,7 @@

     const/16 v6, 0x1194

-    invoke-interface {v3, v4, v5, v6}, Landroid/hardware/display/IDisplayManager;->setDisplayStateOverride(Landroid/os/IBinder;II)V
+    nop

     goto :goto_1

diff --git a/smali_classes2/com/android/systemui/power/feature/aod/AodTriggerExecutor$DozeChargingSessionImpl.smali b/smali_classes2/com/android/systemui/power/feature/aod/AodTriggerExecutor$DozeChargingSessionImpl.smali
--- a/smali_classes2/com/android/systemui/power/feature/aod/AodTriggerExecutor$DozeChargingSessionImpl.smali
+++ b/smali_classes2/com/android/systemui/power/feature/aod/AodTriggerExecutor$DozeChargingSessionImpl.smali
@@ -201,7 +201,15 @@

     check-cast p0, Lcom/android/systemui/doze/PluginAODManager;

-    invoke-virtual {p0, v3}, Lcom/android/systemui/doze/PluginAODManager;->chargingAnimStarted(Z)V
+    iget-object v0, p0, Lcom/android/systemui/doze/PluginAODManager;->mHandler:Lcom/android/systemui/doze/PluginAODManager$10;
+
+    new-instance v1, Lcom/android/systemui/power/feature/aod/AodTriggerExecutor$DozeChargingSessionImpl$$ExternalSyntheticLambda0;
+
+    invoke-direct {v1, p0}, Lcom/android/systemui/power/feature/aod/AodTriggerExecutor$DozeChargingSessionImpl$$ExternalSyntheticLambda0;-><init>(Lcom/android/systemui/doze/PluginAODManager;)V
+
+    invoke-virtual {v0, v1}, Landroid/os/Handler;->post(Ljava/lang/Runnable;)Z
+
+    move-result p0

     sget-object p0, Lkotlin/Unit;->INSTANCE:Lkotlin/Unit;
     :try_end_3

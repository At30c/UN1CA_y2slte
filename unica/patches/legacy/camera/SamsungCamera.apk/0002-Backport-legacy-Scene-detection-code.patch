From 917579d38efc5e745106e5ccd0de689b7f9a2624 Mon Sep 17 00:00:00 2001
From: HackMeGG <58815983+HackMeGG@users.noreply.github.com>
Date: Sat, 19 Sep 2026 11:36:01 +0200
Subject: [PATCH] Backport legacy Scene detection code

Adapted for the Android 17 SamsungCamera callback layout by At30c.
Upstream: salvogiangri/UN1CA ec9e5c1abda401d32d72e962ae6d2fd0d5abf31a

The newer camera app obtains text-detection state through the Y0 metadata
key. Legacy camera HALs do not publish that key. Their regular preview path
does publish the scene-detection I0 array, while a few processing makers also
report the corresponding event through their scene-detection node. Prefer the
regular preview metadata and retain the node event as a fallback.

---
 .../TextDetectionInfoCallbackForwarder.smali       |  4 ++++
 .../camera/core2/maker/MakerCallbackManager.smali  | 52 +++++++++++++++++---
 .../android/camera/core2/maker/t.smali              |  2 ++
 .../android/camera/core2/maker/o0.smali             |  2 ++
 4 files changed, 55 insertions(+), 5 deletions(-)

diff --git a/smali_classes2/com/samsung/android/camera/core2/callback/forwarder/TextDetectionInfoCallbackForwarder.smali b/smali_classes2/com/samsung/android/camera/core2/callback/forwarder/TextDetectionInfoCallbackForwarder.smali
--- a/smali_classes2/com/samsung/android/camera/core2/callback/forwarder/TextDetectionInfoCallbackForwarder.smali
+++ b/smali_classes2/com/samsung/android/camera/core2/callback/forwarder/TextDetectionInfoCallbackForwarder.smali
@@ -15,6 +15,10 @@
 .end annotation
 
 
+# static fields
+.field public static volatile sceneDetectionEvent:I
+
+
 # instance fields
 .field public e:Ljava/lang/Integer;
 
diff --git a/smali_classes2/com/samsung/android/camera/core2/maker/MakerCallbackManager.smali b/smali_classes2/com/samsung/android/camera/core2/maker/MakerCallbackManager.smali
--- a/smali_classes2/com/samsung/android/camera/core2/maker/MakerCallbackManager.smali
+++ b/smali_classes2/com/samsung/android/camera/core2/maker/MakerCallbackManager.smali
@@ -3858,6 +3858,10 @@
     return-object p0
 
     :cond_0
+    const/4 v0, -0x1
+
+    sput v0, Lcom/samsung/android/camera/core2/callback/forwarder/TextDetectionInfoCallbackForwarder;->sceneDetectionEvent:I
+
     new-instance v0, Lcom/samsung/android/camera/core2/callback/forwarder/TextDetectionInfoCallbackForwarder;
 
     invoke-direct {v0, p0, p1, p2}, Lcom/samsung/android/camera/core2/callback/forwarder/CallbackForwarder;-><init>(Ljava/lang/String;Ljava/lang/Object;Landroid/os/Handler;)V
@@ -7364,19 +7368,57 @@
 .method private static lambda$initializeSendCallbackMap$156(Lcom/samsung/android/camera/core2/CamDevice;Ljava/lang/Long;Landroid/hardware/camera2/CaptureResult;Lcom/samsung/android/camera/core2/callback/forwarder/CallbackForwarder;)V
-    .locals 1
+    .locals 2
 
     check-cast p3, Lcom/samsung/android/camera/core2/callback/forwarder/TextDetectionInfoCallbackForwarder;
 
     invoke-virtual {p3}, Ljava/lang/Object;->getClass()Ljava/lang/Class;
 
     if-eqz p0, :cond_0
 
-    sget-object v0, Lcom/samsung/android/camera/core2/local/vendorkey/SemCaptureResult;->Y0:Landroid/hardware/camera2/CaptureResult$Key;
 
-    invoke-static {p2, v0}, Lcom/samsung/android/camera/core2/local/vendorkey/SemCaptureResult;->a(Landroid/hardware/camera2/CaptureResult;Landroid/hardware/camera2/CaptureResult$Key;)Ljava/lang/Object;
 
-    move-result-object p2
 
-    check-cast p2, Ljava/lang/Integer;
+    sget-object v0, Lcom/samsung/android/camera/core2/local/vendorkey/SemCaptureResult;->I0:Landroid/hardware/camera2/CaptureResult$Key;
+
+    invoke-static {p2, v0}, Lcom/samsung/android/camera/core2/local/vendorkey/SemCaptureResult;->a(Landroid/hardware/camera2/CaptureResult;Landroid/hardware/camera2/CaptureResult$Key;)Ljava/lang/Object;
+
+    move-result-object p2
+
+    check-cast p2, [J
+
+    if-eqz p2, :cond_1
+
+    const/4 v0, 0x1
+
+    aget-wide v0, p2, v0
+
+    long-to-int p2, v0
+
+    goto :goto_0
+
+    :cond_1
+    sget p2, Lcom/samsung/android/camera/core2/callback/forwarder/TextDetectionInfoCallbackForwarder;->sceneDetectionEvent:I
+
+    :goto_0
+    const/4 v0, 0x2
+
+    if-eq p2, v0, :cond_2
+
+    const/16 v0, 0x27
+
+    if-ne p2, v0, :cond_3
+
+    :cond_2
+    const/4 p2, 0x1
+
+    goto :goto_1
+
+    :cond_3
+    const/4 p2, 0x0
+
+    :goto_1
+    invoke-static {p2}, Ljava/lang/Integer;->valueOf(I)Ljava/lang/Integer;
+
+    move-result-object p2
 
     iget-object v0, p3, Lcom/samsung/android/camera/core2/callback/forwarder/TextDetectionInfoCallbackForwarder;->e:Ljava/lang/Integer;
 
diff --git a/smali_classes2/com/samsung/android/camera/core2/maker/t.smali b/smali_classes2/com/samsung/android/camera/core2/maker/t.smali
--- a/smali_classes2/com/samsung/android/camera/core2/maker/t.smali
+++ b/smali_classes2/com/samsung/android/camera/core2/maker/t.smali
@@ -26,6 +26,8 @@
 .method public final b(I[J)V
     .locals 0
 
+    sput p1, Lcom/samsung/android/camera/core2/callback/forwarder/TextDetectionInfoCallbackForwarder;->sceneDetectionEvent:I
+
     iget-object p0, p0, Lcom/samsung/android/camera/core2/maker/t;->a:Lcom/samsung/android/camera/core2/maker/AutoBeautyPhotoMaker;
 
     invoke-static {p0, p1, p2}, Lcom/samsung/android/camera/core2/maker/AutoBeautyPhotoMaker;->G0(Lcom/samsung/android/camera/core2/maker/AutoBeautyPhotoMaker;I[J)V
diff --git a/smali_classes4/com/samsung/android/camera/core2/maker/o0.smali b/smali_classes4/com/samsung/android/camera/core2/maker/o0.smali
--- a/smali_classes4/com/samsung/android/camera/core2/maker/o0.smali
+++ b/smali_classes4/com/samsung/android/camera/core2/maker/o0.smali
@@ -34,6 +34,8 @@
 .method public final b(I[J)V
     .locals 1
 
+    sput p1, Lcom/samsung/android/camera/core2/callback/forwarder/TextDetectionInfoCallbackForwarder;->sceneDetectionEvent:I
+
     iget v0, p0, Lcom/samsung/android/camera/core2/maker/o0;->a:I
 
     iget-object p0, p0, Lcom/samsung/android/camera/core2/maker/o0;->b:Lcom/samsung/android/camera/core2/maker/ProcessingPhotoMakerBase;
